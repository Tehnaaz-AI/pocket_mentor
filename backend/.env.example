# 5001 not 5000: on macOS, AirPlay Receiver (ControlCenter) occupies port 5000
# and silently answers every request with 403 AirTunes.
PORT=5001
JWT_SECRET=pocket_mentor_super_jwt_secret_998877
CLIENT_URL=http://localhost:5173

# ── AI provider selection ─────────────────────────────────────────────
# 'groq' or 'gemini'. Both implementations live in aiService.js; this only
# chooses which one callAI() dispatches to. The heuristic engine remains the
# final fallback for either provider.
AI_PROVIDER=groq

# ── Groq (OpenAI-compatible chat completions) ────────────────────────
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Primary Gemini API Key (Optional)
GEMINI_API_KEY=

# Fallback Gemini Keys for reaching higher quotas / handling rate limits (comma-separated or fallback vars)
# Example: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=
GEMINI_FALLBACK_KEY_1=
GEMINI_FALLBACK_KEY_2=

# Model priority: one stable primary, one fallback.
# NOTE: gemini-1.5-*/2.0-flash are retired (404); gemini-2.5-flash is
# closed to new users (404). gemini-3.6-flash is the current recommendation.
GEMINI_MODELS=gemini-3.6-flash,gemini-flash-latest

# Database (Default embedded JSON store runs automatically if MongoDB is not running)
MONGODB_URI=mongodb://localhost:27017/pocketmentor
